<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF"/> <!-- Цвет фона поля, например белый -->
    <stroke
        android:width="2dp"
        android:color="@color/grey"/> <!-- Цвет и толщина границы, например красный -->
    <corners android:radius="10dp"/> <!-- Скругление углов -->
    <padding android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp"/>
</shape>
